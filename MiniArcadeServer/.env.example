# Kopieren nach .env und anpassen:  cp .env.example .env
# Passwort fuer die Handy-Seite (Pflicht, lang und zufaellig)
ADMIN_PASSWORD=bitte-aendern
# PIN, mit der sich jede Konsole einmal koppelt (Ziffern, am besten 8).
# Leer = der Server erzeugt eine und schreibt sie ins Log.
CONSOLE_PIN=
# Port im Container (der Reverse-Proxy leitet dorthin)
PORT=8080
# Port und Adresse auf dem Host: 127.0.0.1 = nur fuer einen Proxy auf derselben Maschine;
# Proxy auf einer anderen Maschine: die (private) IP dieses Servers oder 0.0.0.0 - und per
# Firewall nur den Proxy auf diesen Port lassen (README)
HOST_PORT=8080
BIND_IP=127.0.0.1
# Unterpfad, falls der Proxy den Server z. B. unter https://example.de/tv anbietet (sonst leer)
BASE_PATH=
# Such- und Listen-Ergebnisse so viele Minuten merken
CACHE_MINUTES=10
# Platz fuer Vorschaubilder auf dem Volume
THUMB_CACHE_MB=50
# yt-dlp alle so viele Stunden aktualisieren (0 = nie, auch nicht beim Start)
YTDLP_UPDATE_HOURS=24
# Kategorien auf der Startseite: Name=Suchbegriff; ... (leerer Begriff = "Beliebt" aus allen anderen)
CATEGORIES=Beliebt=;Musik=musik;Gaming=gaming;News=nachrichten;Sport=sport highlights
# Adresse(n) des Reverse-Proxys (IPs oder Netze, mit Komma). Nur von dort werden
# X-Forwarded-For / X-Real-IP geglaubt (PIN-Sperre, Begrenzungen pro Adresse).
# Leer = die Adresse der Verbindung zaehlt. Beispiel: TRUSTED_PROXIES=10.0.0.5,192.168.10.0/24
TRUSTED_PROXIES=
# Zeitzone (fuer "Pause bis 18:45")
TZ=Europe/Berlin

# --- YouTube, optional: eigener Weg nach draussen (README, "IP sauber halten") ---
# Alles zu YouTube ueber diesen Proxy, z. B. socks5://user:pass@zuhause.example.de:1080 oder http://...
YT_PROXY=
# ... oder von einer zusaetzlichen Adresse dieses Servers aus (IPv4 oder IPv6)
YT_SOURCE_ADDRESS=
# nach "Sign in to confirm you're not a bot" / 403 / 429: so viele Stunden keine YouTube-Anfrage
YT_COOLDOWN_HOURS=6
# hoechstens so viele yt-dlp-Aufrufe pro Minute (alle Konsolen zusammen)
YT_REQUESTS_PER_MIN=20
# hoechstens so viele Vorschaubilder pro Minute
YT_THUMBS_PER_MIN=60
# Sekunden Pause zwischen den Anfragen innerhalb eines yt-dlp-Aufrufs
YT_SLEEP_REQUESTS=1
