"..nnaaannnnsnn.."
".nnnaannnnsssnn."
".nnnnnnnnnnsnnn."
"nnnnnnaannnnnnnn"
"nnsnnaaaannnnnnn"
"nsssnnaannnnaann"
"nnsnnnnnnnnaaann"
".nnnnnnsnnnnaan."
".nnnnnsssnnnnnn."
"..nnnnnsnnnnnn.."
"...nnnnnnnaann.."
"....nnnnnnnn...."
"......nnnn......"

