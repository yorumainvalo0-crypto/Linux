CONFIG_FREERTOS_HZ=1000
# the games run in the main task: room for their locals and the CPU players
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
CONFIG_COMPILER_OPTIMIZATION_SIZE=y
CONFIG_BOOTLOADER_COMPILER_OPTIMIZATION_SIZE=y
CONFIG_LOG_DEFAULT_LEVEL_NONE=y
# smaller printf - the symbol was renamed in IDF 6, keep both
CONFIG_NEWLIB_NANO_FORMAT=y
CONFIG_LIBC_NEWLIB_NANO_FORMAT=y
CONFIG_COMPILER_CXX_EXCEPTIONS=n
CONFIG_COMPILER_CXX_RTTI=n
CONFIG_ESP_ERR_TO_NAME_LOOKUP=n
CONFIG_ESP_TASK_WDT_INIT=n
CONFIG_ESP_SYSTEM_PANIC_SILENT_REBOOT=y
CONFIG_ESP_DEBUG_STUBS_ENABLE=n
CONFIG_HAL_ASSERTION_DISABLE=y
CONFIG_COMPILER_OPTIMIZATION_ASSERTIONS_DISABLE=y

# --- WLAN and updates ---
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
# a new image that dies before it reaches the menu is rolled back
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
# root certificates for github.com - the common set is enough and smaller
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_CMN=y
# browsers send long headers, captive portal checks long URLs
CONFIG_HTTPD_MAX_REQ_HDR_LEN=1024
CONFIG_HTTPD_MAX_URI_LEN=512
CONFIG_LWIP_IPV6=n
# TV (tv.h, tvnet.cpp): one TLS connection next to the WLAN and the 75 kB picture.
# Record buffers only while a record is on its way, the certificates freed after
# the handshake. The incoming records stay up to 16 kB (any reverse proxy).
CONFIG_MBEDTLS_DYNAMIC_BUFFER=y
CONFIG_MBEDTLS_DYNAMIC_FREE_CONFIG_DATA=y
CONFIG_MBEDTLS_DYNAMIC_FREE_CA_CERT=y
# a wider TCP window, so the video is not held back by the round trip
CONFIG_LWIP_TCP_WND_DEFAULT=11520
CONFIG_LWIP_TCP_RECVMBOX_SIZE=12

# --- colour display ---
# the SPI driver runs from IRAM, so a frame can go out while flash is busy
CONFIG_SPI_MASTER_IN_IRAM=y
